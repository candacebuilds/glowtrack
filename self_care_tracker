import random
import json

def log_mood():
    mood = input("How are you feeling today? ")

    if mood == "happy":
        print("I love that for you ✨")

    elif mood == "sad":
        print("Tomorrow is a new day 💖")

    elif mood == "stressed":
        print("Take a deep breath. You’re doing your best 🌸")

    elif mood == "tired":
        print("Rest is productive too 🌙")

    print("Your mood today is:", mood)
    print("Thank you for checking in 💖")

def show_affirmation():
    affirmations = [
        "You are growing every day 🌱",
        "Small progress still counts ✨",
        "You are allowed to rest 🌙",
        "You are stronger than you think 💖",
        "One step at a time is still movement 👣"
    ]

    affirmation = random.choice(affirmations)

    print("Your affirmation for today:")
    print(affirmation)

def track_habits():
    habits = ["drink water", "coding practice", "reading", "self-care"]

    print("Today's habits:")

    completed = 0

    for habit in habits:
        answer = input(f"Did you complete {habit}? yes/no: ")

        if answer == "yes":
            completed += 1
            print("Great job! ✅")
        else:
            print("That's okay, try again tomorrow 🌸")

    print("🏆 Habits Completed:", completed, "/4")

def track_water():
    daily_goal = 64
    current_total = 0

    print("\n💧 Water Tracker")
    print("Daily Goal:", daily_goal, "oz")
    print("Current Total:", current_total, "oz")

    water = int(input("\nHow many ounces would you like to add today? "))

    current_total += water

    remaining = daily_goal - current_total

    if current_total >= daily_goal:
        remaining = 0

    print("\nGreat job staying hydrated! 💧")
    print("Current Total:", current_total, "oz")

    if current_total >= daily_goal:
        print("🎉 Amazing job!")
        print("You reached today's hydration goal!")

    elif current_total >= 40:
        print("🌸 You're almost there!")
        print("Keep sipping!")

    else:
        print("💧 Great start!")
        print("Every sip counts.")

    print("Remaining:", remaining, "oz")

def journal_entry():
    print("\n📝 Daily Journal")

    journal = input("What's on your mind today? ")

    data = {
        "journal": journal
    }

    with open("glowtrack_data.json", "w") as file:
        json.dump(data, file, indent=4)

    print("\n✨ Your journal entry:")
    print(journal)

    print("\nThank you for taking time to reflect today. 🌸")

def view_journal():
    with open("glowtrack_data.json", "r") as file:
        data = json.load(file)

    print("\n📖 Your saved journal entry:")
    print(data["journal"])


def main():
    while True:
        print("\nWelcome to GlowTrack ✨")
        print("1. Log Mood")
        print("2. Track Habits")
        print("3. Daily Affirmation")
        print("4. Water Tracker")
        print("5. Journal Entry")
        print("6. View Saved Journal")
        print("7. Exit")

        choice = input("Choose an option: ")

        if choice == "1":
            log_mood()

        elif choice == "2":
            track_habits()

        elif choice == "3":
            show_affirmation()

        elif choice == "4":
            track_water()

        elif choice == "5":
            journal_entry()

        elif choice == "6":
            view_journal()

        elif choice == "7":
            print("Thank you for using GlowTrack! 💖")
            break

        else:
            print("Invalid option. Please choose 1–7.")


main()